          <datasource-dependencies datasource='federated.07ajgtq0e78auo1000f3m1cfyoc3'>
            <column caption='Revenue' datatype='real' default-format='c&quot;Rp&quot;#,##0,,.00M' name='[Calculation_1215023717044224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Status] = &quot;Success&quot; THEN [Quantity]* [Unit Price]*(1-[Discount]) END' />
            </column>
            <column caption='Profit' datatype='real' default-format='c&quot;Rp &quot;#,##0,,.00M;(&quot;Rp &quot;#,##0,,.00M)' name='[Calculation_1215023718457345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Status] = &quot;Success&quot; THEN [Quantity]* ([Unit Price]*(1-[Discount])-[Unit Cost]) END' />
            </column>
            <column caption='Profit Ratio' datatype='real' default-format='p0.00%' name='[Calculation_1215023721000962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1215023718457345])/SUM([Calculation_1215023717044224])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Channel]' role='dimension' type='nominal' />
