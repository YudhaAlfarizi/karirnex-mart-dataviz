    <dashboard name='Story Performa KarirNex Mart 2025' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='542' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98178' id='1' param='vert' removable='false' type-v2='layout-flow' w='99002' x='499' y='911'>
            <zone h='5695' id='3' type-v2='title' w='99002' x='499' y='911' />
            <zone fixed-size='294' h='33485' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99002' x='499' y='6606' />
            <zone h='58998' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99002' x='499' y='40091'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Konteks: KarirNex Mart Tumbuh Sehat di 2025 &#10;“Revenue Rp773,03M, Profit Rp237,95M (ratio 30,78%). Jakarta memimpin Rp124,86M. Penjualan memuncak di Maret dan Desember.”' captured-sheet='Dashboard ' id='1' />
                  <story-point caption='Konflik: Penjualan Besar Belum Tentu Untung Besar &#10;&quot;Minyak Goreng 1L adalah produk terlaris kedua, tapi Profit Ratio-nya hanya 17,1%, terendah. Pembersih Wajah revenue #1 dan margin tertinggi (38,8%), tapi rating terendah (3,68) dan retur 8,1%&quot;' captured-sheet='Dashboard 2' id='2' />
                  <story-point caption='Resolusi: Jaga Margin, Perbaiki Kualitas, Benahi Channel Online&#10;Naikkan harga atau bundling Minyak Goreng dengan produk margin tinggi (Shampo, Sabun Mandi).&#10;Audit kualitas Pembersih Wajah untuk menurunkan retur dan menaikkan rating.&#10;Benahi proses channel online (Success Rate Toko Oren dan Toko Hijau 76 sampai 79% vs Offline 97%).&#10;Batasi diskon maksimal 10%.' captured-sheet='Dashboard ' id='3' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{71A75C6B-D364-4DA9-AA5F-AA7E1BE95732}' />
    </dashboard>
